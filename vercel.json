{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dokind.ai" }],
      "destination": "https://dokind.ai/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/deadlines",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/tuesday-updates",
      "schedule": "0 19 * * 2"
    },
    {
      "path": "/api/cron/review-sla",
      "schedule": "0 * * * *"
    }
  ]
}
